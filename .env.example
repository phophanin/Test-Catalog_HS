# HOME SPORT - Environment Configuration
# Next.js & Supabase Configuration

# Supabase Public Keys (Fill these when deploying with your live Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Store Info & Social Ordering Channels
NEXT_PUBLIC_STORE_NAME=HOME SPORT
NEXT_PUBLIC_STORE_PHONE=+855 12 345 678
NEXT_PUBLIC_STORE_TELEGRAM=homesportkh
NEXT_PUBLIC_STORE_MESSENGER=homesportcambodia
NEXT_PUBLIC_STORE_ADDRESS=St 271, Sangkat Boeung Tumpun, Khan Mean Chey, Phnom Penh, Cambodia
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_USD_TO_KHR_RATE=4100
